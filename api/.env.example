# Runtime: development | test | production
NODE_ENV=development
# Port the API listens on
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budget_planner
# Secret used to sign auth tokens (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-32chars
# Origin of the web app allowed by CORS
CORS_ORIGIN=http://localhost:3000
