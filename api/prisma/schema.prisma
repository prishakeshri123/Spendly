generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money rules: amounts are Int minor units (paise/cents), always stored with a currency code.
// Every table except User carries userId, and every query must filter by it.

enum AccountType {
  CASH
  BANK
  CARD
  WALLET
  OTHER
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
}

model Account {
  id             String      @id @default(uuid())
  userId         String
  name           String
  type           AccountType @default(BANK)
  currency       String
  openingBalance Int         @default(0)
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  transactions      Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransactionTransferAccount")

  @@index([userId])
}

model Category {
  id         String       @id @default(uuid())
  userId     String
  name       String
  kind       CategoryKind @default(EXPENSE)
  color      String?
  icon       String?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, kind])
  @@index([userId])
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  accountId         String
  categoryId        String?
  type              TransactionType
  // Always positive; the direction comes from `type`.
  amount            Int
  currency          String
  occurredAt        DateTime
  note              String?
  // Destination account, only set when type is TRANSFER.
  transferAccountId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  account         Account   @relation("TransactionAccount", fields: [accountId], references: [id])
  transferAccount Account?  @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id])
  category        Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, occurredAt])
  @@index([userId, categoryId])
  @@index([accountId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  // "YYYY-MM", e.g. "2026-10"
  month      String
  amount     Int
  currency   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}
